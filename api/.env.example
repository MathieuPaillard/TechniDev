# Modèle : copier vers .env et remplacer les valeurs. Ne jamais committer .env.

# Base PostgreSQL de DÉVELOPPEMENT (Neon). En production, la chaîne doit contenir sslmode=verify-full.
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE/BASE?sslmode=verify-full

# Adresse du site : seule origine acceptée pour les requêtes qui modifient quelque chose.
FRONT_URL=http://localhost:4321

PORT=3000
NODE_ENV=development

# Obligatoire en production : même valeur que API_SIGNATURE_TOKEN côté Netlify.
NETLIFY_SIGNATURE=

# Seulement pour créer ou remplacer le compte administrateur (npm run create-admin). À retirer ensuite.
ADMIN_LOGIN=
ADMIN_PASSWORD=
