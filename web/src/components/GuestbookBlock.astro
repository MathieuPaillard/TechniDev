---
// Bloc « Laisser un mot » d'une démo (SPEC §B8) : les trois derniers messages qui en parlent, et un lien vers le
// formulaire du livre d'or, la démo déjà choisie. Rendu seulement quand l'API est branchée.
import '../styles/guestbook.css';

interface Props {
  /** Rattachement des messages : `demo:<slug>`. */
  page: string;
}

const { page } = Astro.props;
---

<section class="guestbook-block" data-guestbook-block data-page={page} aria-labelledby="guestbook-block-title">
  <div class="guestbook-block-head">
    <h2 id="guestbook-block-title">Laisser un mot</h2>
    <a class="btn btn-quiet" href={`/livre-d-or?sujet=${encodeURIComponent(page)}#ecrire`}>Écrire un mot sur cette démo</a>
  </div>
  <p class="guestbook-status" data-guestbook-status hidden></p>
  <p class="visually-hidden" role="status" data-guestbook-live></p>
  <ol class="messages" data-guestbook-list></ol>
  <div class="guestbook-actions">
    <a class="btn btn-quiet" href="/livre-d-or" data-guestbook-more hidden>Lire tout le livre d'or</a>
    <button class="btn btn-quiet" type="button" data-guestbook-retry hidden>Réessayer</button>
  </div>
</section>

<script>
  import '../lib/guestbook/block';
</script>

<style>
  .guestbook-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .guestbook-block-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
  }
</style>
