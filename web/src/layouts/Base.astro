---
// Squelette commun à toutes les pages : en-tête, contenu, pied de page, scripts communs.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import signFont from '../assets/fonts/tilt-neon-latin.woff2?url';
import bodyFont from '../assets/fonts/atkinson-hyperlegible-next-latin.woff2?url';

interface Props {
  title: string;
  description?: string;
  current?: 'labo' | 'projets' | 'livre-d-or' | undefined;
}

const {
  title,
  description = 'Les projets de Mathieu Paillard et un labo de démos jouables : gravité, ondes, chimie, arithmétique, comptes entre amis.',
  current,
} = Astro.props;
---

<!doctype html>
<html lang="fr" data-gas="ar">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070a1a" />
    <!-- Pas d'indexation tant que le contenu n'est pas relu : à retirer pour apparaître dans les moteurs de recherche. -->
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={signFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <script is:inline src="/init.js"></script>
    <title>{title === 'TechniDev' ? 'TechniDev · Mathieu Paillard' : `${title} · TechniDev`}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header current={current} />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <script>
      import '../lib/ui/chrome';
    </script>
  </body>
</html>
